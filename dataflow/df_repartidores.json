{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(repartidor_id = trim(repartidor_id),",
				"          nombre_repartidor = initCap(trim(nombre_repartidor)),",
				"          tipo_vehiculo = trim(tipo_vehiculo),",
				"          ciudad_base = trim(ciudad_base),",
				"          fecha_alta = iif(     instr(fecha_alta,'/') > 0,     toDate(fecha_alta,'dd/MM/yyyy'),     toDate(fecha_alta,'yyyy-MM-dd') ),",
				"          activo = trim(activo)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(repartidor_id) && repartidor_id != '' && !isNull(nombre_repartidor) && nombre_repartidor != '' && !isNull(tipo_vehiculo) && tipo_vehiculo != '' && !isNull(fecha_alta) && !isNull(activo) && activo != '',",
				"     disjoint: false) ~> split1@(activos, rechazados)",
				"split1@activos aggregate(groupBy(repartidor_id),",
				"     nombre_repartidor = first(nombre_repartidor),",
				"          tipo_vehiculo = first(tipo_vehiculo),",
				"          ciudad_base = first(ciudad_base),",
				"          fecha_alta = first(fecha_alta),",
				"          activo = first(activo)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}